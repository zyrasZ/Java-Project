	"item": [
		{
			"name": "1. Register Admin User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    const response = pm.response.json();",
							"    if (response.status === 'success' && response.data.token) {",
							"        pm.environment.set('adminToken', response.data.token);",
							"        console.log('Admin token saved:', response.data.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@collabsphere.com\",\n    \"fullName\": \"System Administrator\",\n    \"password\": \"admin123\",\n    \"role\": \"ADMIN\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				},
				"description": "Tạo admin user đầu tiên và lưu token"
			}
		},
